# ── Mismas variables del ERP (Environment Group "erp-shared" en Render) ──
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=bddgeneral
DB_PORT=5432
JWT_SECRET=            # el MISMO del ERP: así se entra con el usuario del ERP
DB_POOL_MAX=4

# ── Propias de calls-service ──
# Cifra los tokens de Meta guardados. 32+ caracteres aleatorios. NO cambiarla después.
CALLS_ENCRYPTION_KEY=
# URL pública de este servicio (para mostrar la URL del webhook)
PUBLIC_URL=https://calls-service.onrender.com
# Dominios del ERP que pueden embeber el módulo (separados por coma)
ERP_ORIGINS=https://tu-erp.onrender.com,http://localhost:5173
PORT=3090

# Alternativa solo para desarrollo local (si no usas DB_HOST):
# DATABASE_URL=postgres://usuario:clave@localhost:5432/bddgeneral
# PGSSL=false
